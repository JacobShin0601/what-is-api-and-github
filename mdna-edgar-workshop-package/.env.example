# Copy this file to .env, then edit only the values you need.
# Never commit .env or paste its contents into an Agent prompt.

# Required for SEC EDGAR requests. Use a real name and reachable email.
SEC_IDENTITY="Your Name your-email@example.com"

# Required for the Tavily news-verification track.
TAVILY_API_KEY=""

# Optional: SerpAPI search track in the main curriculum.
SERPAPI_KEY=""

# Optional: FRED macro-context track.
FRED_API_KEY=""
